#!/bin/bash
set -euo pipefail

hooks_dir=$(git rev-parse --git-path hooks 2>/dev/null) || {
    echo "Error: not inside a git repository." >&2
    exit 1
}

hook_file="$hooks_dir/pre-push"

if [[ -e "$hook_file" ]]; then
    echo "A pre-push hook already exists at $hook_file — refusing to overwrite." >&2
    exit 1
fi

cat > "$hook_file" <<'EOF'
#!/bin/bash

branch_name=$(git rev-parse --abbrev-ref HEAD)

prefix="mm-local/"

if [[ "$branch_name" == "$prefix"* ]]; then
    echo "Pre-push hook: Branch is not allowed to be pushed to remote."
    exit 1
fi

exit 0
EOF

chmod +x "$hook_file"
echo "Installed pre-push guard at $hook_file"
